# --- runtime ---------------------------------------------------------------
SAHARA_OFFLINE=0                      # 1 = no Gemini, no telephony, no WhatsApp (tests, demos)
SAHARA_PUBLIC_URL=https://your-host   # must be reachable by Twilio/Plivo (ngrok in week one)
SAHARA_DATA_DIR=data
SAHARA_TIMEZONE=Asia/Kolkata
SAHARA_OPERATOR_TOKEN=change-me       # required header X-Sahara-Token on /api/*
SAHARA_RETENTION_DAYS=30

# --- Gemini ------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE        # FALSE + GOOGLE_API_KEY to use the Gemini Developer API
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LOCATION=global
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview       # or gemini-live-2.5-flash-preview-native-audio-09-2025
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VOICE=Kore
SAHARA_VOICE_ENGINE=gemini_live       # or cascade (Sarvam ASR/TTS + Gemini text)
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_TTS_SPEAKER=anushka

# --- telephony ---------------------------------------------------------------
SAHARA_TELEPHONY=twilio               # or plivo
SAHARA_CALLER_ID=+91xxxxxxxxxx        # the number Sahara calls from (and that parents can forward to)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=

# --- WhatsApp to the child -----------------------------------------------------
SAHARA_WHATSAPP=console               # meta | twilio | console
# META_WA_TOKEN=
# META_WA_PHONE_ID=
# META_WA_TEMPLATE=sahara_daily_summary
# TWILIO_WA_FROM=whatsapp:+14155238886

# --- call behaviour --------------------------------------------------------------
SAHARA_MAX_CALL_SECONDS=240
SAHARA_RETRY_AFTER_MINUTES=30
SAHARA_MAX_ATTEMPTS=2
